{
	"versionGroups": [
		{
			"label": "Use workspace protocol for local packages",
			"dependencies": ["$LOCAL"],
			"dependencyTypes": ["!local"],
			"pinVersion": "workspace:*"
		},
		{
			"label": "Ignore .version properties of local packages",
			"dependencyTypes": ["local"],
			"isIgnored": true
		},
		{
			"label": "pnpm catalog (see pnpm-workspace.yaml)",
			"dependencies": [
				"@biomejs/biome",
				"@orpc/client",
				"@orpc/openapi",
				"@orpc/server",
				"@orpc/zod",
				"@t3-oss/env-core",
				"@t3-oss/env-nextjs",
				"@tanstack/react-query",
				"@trigger.dev/sdk",
				"@types/react",
				"@types/react-dom",
				"better-auth",
				"dotenv",
				"drizzle-orm",
				"next",
				"react",
				"react-dom",
				"typescript",
				"zod"
			],
			"dependencyTypes": ["prod", "dev", "peer"],
			"policy": "catalog"
		}
	]
}
