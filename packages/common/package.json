{
	"name": "@lyterion/common",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./pipeline/start": {
			"default": "./src/pipeline/start.ts"
		},
		"./review": {
			"default": "./src/review/persist.ts"
		},
		"./credentials": {
			"default": "./src/credentials/index.ts"
		},
		"./trigger/tasks/*": {
			"default": "./src/trigger/tasks/*.ts"
		}
	},
	"dependencies": {
		"@lyterion/ai-provider": "workspace:*",
		"@lyterion/core": "workspace:*",
		"@lyterion/db": "workspace:*",
		"@lyterion/env": "workspace:*",
		"@lyterion/logger": "workspace:*",
		"@trigger.dev/sdk": "catalog:",
		"ai": "catalog:",
		"drizzle-orm": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@lyterion/config": "workspace:*",
		"typescript": "catalog:",
		"vitest": "^5.0.0"
	}
}
