# Database (docker/docker-compose.yml)
LYTERION_DATABASE_URL=postgresql://postgres:password@localhost:5434/lyterion

# URLs
NEXT_PUBLIC_LYTERION_NODE_ENV=development
NEXT_PUBLIC_LYTERION_API_URL=http://localhost:3001
NEXT_PUBLIC_LYTERION_DASHBOARD_URL=http://localhost:3002
NEXT_PUBLIC_LYTERION_ALLOWED_ORIGIN=http://localhost:3002
# Dashboard server -> api, when the public api host isn't reachable from the container (set by the deploy script)
LYTERION_API_INTERNAL_URL=

# Auth (owner only)
LYTERION_BETTER_AUTH_SECRET=
# Optional: encrypts credentials entered in the dashboard, derived from the auth secret when empty
LYTERION_ENCRYPTION_KEY=
LYTERION_SPOTIFY_CLIENT_ID=
LYTERION_SPOTIFY_CLIENT_SECRET=
# Previews only: production api url that owns the Spotify callback, and the shared cookie domain
LYTERION_AUTH_PRODUCTION_URL=
LYTERION_COOKIE_DOMAIN=

# AI
LYTERION_GROQ_API_KEY=
LYTERION_JEV_API_KEY=

# Trigger.dev, self-hosted on the-keep
LYTERION_TRIGGER_API_URL=
LYTERION_TRIGGER_PROJECT_REF=
LYTERION_TRIGGER_SECRET_KEY=

# Library paths as seen inside the containers (docs/architecture.md)
LYTERION_MUSIC_DIR=/music
LYTERION_LIBRARY_SUBDIR=lyterion
LYTERION_STAGING_DIR=/staging
LYTERION_STAGING_BUDGET_GB=50
LYTERION_MIN_FREE_GB=100
LYTERION_MAX_BIT_DEPTH=16
LYTERION_MAX_SAMPLE_RATE_HZ=44100

# Navidrome, Subsonic calls run as this user (stars are per user, D-024)
LYTERION_NAVIDROME_URL=
LYTERION_NAVIDROME_USER=
LYTERION_NAVIDROME_PASSWORD=

# Providers, each one is disabled while its vars are empty
LYTERION_SLSKD_URL=
LYTERION_SLSKD_API_KEY=
LYTERION_SLSKD_DOWNLOADS_DIR=/slskd/downloads
LYTERION_PROXY_BACKENDS=
LYTERION_DEEZER_ARL=
LYTERION_STREAMRIP_CONFIG_PATH=
LYTERION_YTDLP_COOKIES_PATH=
LYTERION_YTDLP_POT_PROVIDER_URL=
LYTERION_LIDARR_URL=
LYTERION_LIDARR_API_KEY=
LYTERION_BANDCAMP_COOKIE=
LYTERION_ANNA_DIR=/anna
LYTERION_ACOUSTID_API_KEY=
LYTERION_MUSICBRAINZ_USER_AGENT=Lyterion/0.0.0 ( hi@findmalek.com )

# ntfy on the-keep (D-031, D-034)
LYTERION_NTFY_URL=
LYTERION_NTFY_TOPIC=lyterion
LYTERION_NTFY_TOKEN=
